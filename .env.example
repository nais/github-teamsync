LISTEN_ADDRESS=127.0.0.1:3105
NAIS_API_URL=http://localhost:4242/graphql
NAIS_WEBHOOK_SECRET=secret-configured-in-nais-console
NAIS_WEBHOOK_SOURCE=console.<tenant>.cloud.nais.io/cloudevents
GITHUB_ORG=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_FILE=
GITHUB_IDENTITY_PROVIDER=organization-saml
# Enterprise SAML/OIDC requires an enterprise installation of the same App with read-only SSO permission.
# GITHUB_ENTERPRISE=
SYNC_INTERVAL=30m
SYNC_TIMEOUT=30m
SYNC_WORKERS=5
TEAM_TIMEOUT=2m
# Preview GitHub team and membership writes. Set false to apply them.
DRY_RUN=true
LOG_FORMAT=text
LOG_LEVEL=info
